{
  "manifest_version": 3,
  "name": "AgentDesk DOM Mirror (dev)",
  "version": "0.0.1",
  "description": "Mirrors a Chrome tab's DOM to AgentDesk via rrweb (ADR-0038/0039). Read-only v1.",
  "key": "",
  "minimum_chrome_version": "111",
  "permissions": [
    "nativeMessaging",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-isolated.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "vendor/rrweb.min.js",
        "record-main.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
