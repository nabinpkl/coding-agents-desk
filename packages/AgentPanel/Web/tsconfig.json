{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    // The agent-feed wire contract, shared with the sidecar so the model has one definition.
    // Vite and Vitest mirror this path because desktop control also consumes its bounded
    // protocol constants at runtime.
    "paths": {
      "@agentdesk/agent-feed-wire": ["../../../agent-feed/wire/index.ts"],
      // `@/` is this project's own src and `@repo/` is the repository, so an import says
      // where a module lives rather than how far away the reader happens to be sitting.
      "@/*": ["./src/*"],
      "@repo/*": ["../../../*"]
    },
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    // No ambient `@types/*`: this is the code that reaches the page, and none of it may lean on
    // Node's globals. Without this every installed `@types` package is loaded, `@types/node` first.
    "types": []
  },
  // The code that reaches the page, and only that. The dev server's config and plugins and every
  // test run in Node, need Node's types and Vite's, and are checked by `tsconfig.node.json`
  // instead. Kept apart because what decides whether an edit can break the page is this check,
  // and it reads about a third less without them.
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "../../../terminal/vendor/xterm/package/typings/xterm.d.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*Harness.tsx",
    "src/app/testSetup.ts",
    "src/app/dev-server/**"
  ]
}
