# Env files (per-machine config). .env.example is checked in as documentation.
.env
.env.local
*.p8

# macOS atomic-write temp artifacts
.!*

# OS noise
.DS_Store

# Xcode per-developer state (scrollback, breakpoints, last-opened files)
xcuserdata/
*.xcuserstate

# Xcode build output and SPM caches
build/
DerivedData/
.swiftpm/
.build/

# Local feature worktrees
.worktrees/

# Maestro UI flow screenshots
client/maestro/screenshots/

# ATC engine sidecar binary. Never tracked: the real binary is ~64 MB and the
# placeholder is regenerated on demand by `just ensure-sidecar-placeholder`
# (a dependency of `just check` and run before bundling). A fresh checkout
# therefore builds cleanly with no git noise from either the placeholder or
# the built binary.
host/AgentDeskHost/atc-sidecar

# Bun --compile temp artifacts
*.bun-build
.*.bun-build

# SDD coordinator ledger (scratch)
.superpowers/
