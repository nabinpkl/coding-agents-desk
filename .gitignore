# Env files (per-machine config). .env.example is checked in as documentation.
.env
.env.local
*.p8

# macOS atomic-write temp artifacts
.!*

# OS noise
.DS_Store
__pycache__/
*.pyc

# Xcode per-developer state (scrollback, breakpoints, last-opened files)
xcuserdata/
*.xcuserstate

# Xcode build output and SPM caches
build/
DerivedData/
.derivedData/
.swiftpm/
.build/

# Local feature worktrees
.worktrees/

# Maestro UI flow screenshots
client/maestro/screenshots/

# Agent feed transcript sidecar binary. Never tracked: the compiled binary and
# placeholder are regenerated by the AgentDesk build.
# (a dependency of `just check` and run before bundling). A fresh checkout
# therefore builds cleanly with no git noise from either the placeholder or
# the built binary.
host/AgentDeskHost/agent-feed-sidecar

# Agent Workspace IDE PTY manager binary. Never tracked: the real Rust binary is
# produced by `just build-pty-runtime`, and placeholders are regenerated on demand
# by `just ensure-pty-runtime-placeholder` for host builds.
host/AgentDeskHost/pty-manager
host/AgentDeskHost/pty-vault

# Voice sidecar inputs staged into the app bundle by `just build-voice-sidecar`
# (run automatically by host-run): the `uv` binary, the complete offline
# wheelhouse, and a read-only copy of the in-repo interaction-agent source.
# Regenerated on demand, never tracked.
host/AgentDeskHost/uv
host/AgentDeskHost/voice-src/
host/AgentDeskHost/voice-wheelhouse/*
!host/AgentDeskHost/voice-wheelhouse/.gitkeep

# Agent feed webview bundle. Never tracked: the real bundle (~5 MB) is produced
# by `just build-agent-webview` and the placeholder is regenerated on demand by
# `just ensure-webview-placeholder` (a dependency of `just sim-test`). A fresh
# checkout therefore builds cleanly with no git noise from either the placeholder
# or the real bundle. The directory itself must exist in git for Xcode to wire
# the folder reference, so a .gitkeep is committed; the contents are ignored.
client/AgentDeskClient/AgentFeedWebview/*
!client/AgentDeskClient/AgentFeedWebview/.gitkeep
# Voice models. Generated by `just voice-phone-model` / `just voice-zipa-model`
# into .build/voice-assets, then published by `just voice-assets-publish` to the
# directory the host serves and to the client test resource root. They are in no
# app bundle: the phone fetches them from its paired Mac over the assets lane.
client/AgentDeskClientTests/VoicePhoneModel.mlmodelc/
client/AgentDeskClientTests/VoicePhoneModelManifest.json
client/AgentDeskClientTests/VoicePhoneVocabulary.json
client/AgentDeskClientTests/VoiceZIPAModel.onnx
client/AgentDeskClientTests/VoiceZIPAModelManifest.json
client/AgentDeskClientTests/VoiceZIPATokens.txt
client/AgentDeskClientTests/VoiceZIPALicense.txt
client/AgentDeskClientTests/VoiceCMUDictionary.txt
client/AgentDeskClientTests/VoiceCMUDictionaryLicense.txt
packages/AgentPanel/Sources/AgentPanel/Resources/AgentPanelWebview/*
!packages/AgentPanel/Sources/AgentPanel/Resources/AgentPanelWebview/.gitkeep
packages/InteractionPanel/Sources/InteractionPanel/Resources/InteractionPanelWebview/*
!packages/InteractionPanel/Sources/InteractionPanel/Resources/InteractionPanelWebview/.gitkeep

# Bun --compile temp artifacts
*.bun-build
.*.bun-build

# SDD coordinator ledger (scratch)
.superpowers/
dom-bridge/dom-bridge

# Extension git-identity stamp (regenerated per load by `just ext-stamp`; the extension parallel of
# the host/client AgentDeskGitSHA -- a build artifact, never committed).
chrome-extension/build-info.json

# CDP-verify throwaway Chrome profile (ADR-0044 Tier B test)
.cdp-verify-profile/

# Library-package resolve files (the host xcodeproj Package.resolved is authoritative)
terminal/emulator/Package.resolved

# graphify's generated knowledge graph -- graph.json/graph.html/GRAPH_REPORT.md
# and the mini import-graph viewer are all regenerated by `graphify update .`
# / `graphify cluster-only .` / `just graphify-import-graph`, and the HTML
# views can run into the tens of MB with embedded data.
graphify-out/
