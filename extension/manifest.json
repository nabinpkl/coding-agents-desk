{
  "manifest_version": 3,
  "name": "AgentDesk Annotator",
  "version": "1.0.0",
  "description": "Click a container or drag a region, comment, and hand agents a structured brief over MCP.",
  "key": "MANIFEST-KEY-REMOVED",
  "minimum_chrome_version": "120",
  "permissions": [
    "activeTab",
    "storage",
    "identity",
    "scripting",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://annotator.example.com/*",
    "https://team.cloudflareaccess.com/*"
  ],
  "action": {
    "default_title": "Annotate this page"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "toggle-annotate": {
      "suggested_key": {
        "default": "Alt+Shift+A",
        "mac": "Alt+Shift+A"
      },
      "description": "Toggle annotate mode"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
