# Copy to deploy/.env on oracle, chmod 600. Never commit the real file.
CF_ACCESS_TEAM_DOMAIN=team.cloudflareaccess.com
CF_ACCESS_AUD=
# clientId=label:machine[:human], comma separated. A machine token speaks for that machine's sessions;
# :human lets it send as the owner (human surfaces).
HUB_PRINCIPALS=<relay-mac client id>=mac:mac:human,<relay-oracle client id>=oracle:oracle:human,<relay-annotator client id>=annotator::human,<relay-e2e client id>=e2e:e2e:human
CLOUDFLARE_TUNNEL_TOKEN=
