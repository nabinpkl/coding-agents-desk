# Copy to deploy/.env on oracle, chmod 600. Never commit the real file.
CF_ACCESS_TEAM_DOMAIN=<team>.cloudflareaccess.com
CF_ACCESS_AUD=
# clientId=label:machine[:human], comma separated. A machine token speaks for that machine's sessions;
# :human lets it send as the owner (human surfaces). Machine tokens are also the only ones that may
# open a session stream, for both the claude and opencode runtimes.
HUB_PRINCIPALS=<relay-mac client id>=mac:mac,<relay-oracle client id>=oracle:oracle,<relay-panel client id>=panel::human,<relay-annotator client id>=annotator::human,<relay-e2e client id>=e2e:e2e:human
# The owner email allowed in as themselves through Managed OAuth (opencode remote MCP, browser flow).
# Empty or absent disables owner login: the hub then speaks only to service tokens above.
HUB_OWNER_EMAIL=
CLOUDFLARE_TUNNEL_TOKEN=
