{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    // For the shared contract fixture, which is JSON so that one document can be read by both the
    // sidecar's tests and the panel's rather than restated as a literal in each.
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "types": ["bun"],
    // The one definition of everything that crosses the HTTP boundary, shared with the Agent
    // Panel. Types only, so every import of it is erased and neither project bundles it.
    "paths": {
      "@agentdesk/agent-feed-wire": ["../wire/index.ts"],
      // `@/` is this project's own src and `@repo/` is the repository, so an import says
      // where a module lives rather than how far away the reader happens to be sitting.
      "@/*": ["./src/*"],
      "@repo/*": ["../../*"]
    }
  },
  // The wire module is typechecked here rather than in both consumers: one owner for the check,
  // and this project's lib is the stricter of the two.
  "include": ["src/**/*.ts", "../wire/**/*.ts"]
}
