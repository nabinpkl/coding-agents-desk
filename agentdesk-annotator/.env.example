# Copy to agentdesk-annotator/.env on the machine you build the extension and run the e2e suite
# from. Never commit the real file. The server's own settings are in deploy/.env (deploy/.env.example).

# Where your annotator server is served, behind Cloudflare Access (deploy/cloudflare.md). The
# extension calls it, the e2e suite tests it, and agents connect to its /mcp.
ANNOTATOR_URL=https://annotator.example.com

# Your Access team domain, the same value as in deploy/.env. The extension signs in through it.
CF_ACCESS_TEAM_DOMAIN=<team>.cloudflareaccess.com

# Optional: a PEM private key that fixes the extension's id. Access accepts the extension's sign-in
# only at the redirect https://<id>.chromiumapp.org/ allowed for it, and `just build-extension`
# prints the id. Without a key, Chrome derives the id from the folder you load extension/dist from,
# so moving that folder means allowing a new redirect. Make one with:
#   openssl genrsa -out ~/.config/agentdesk-annotator/extension-key.pem 2048
ANNOTATOR_EXTENSION_KEY_FILE=
