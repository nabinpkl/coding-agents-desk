# Copy to deploy/.env on the host (chmod 600). Never commit the real file.
# What each value is and where it comes from: deploy/cloudflare.md. Your own ids: deploy/cloudflare.private.md.

# Only for a stack first deployed under another project name: keeps its
# containers and data volume (compose.yml names it agentdesk-annotator).
# COMPOSE_PROJECT_NAME=

# Connector token of the remotely managed tunnel in front of this server.
CLOUDFLARE_TUNNEL_TOKEN=

# Access team domain and the annotator application's AUD tag.
CF_ACCESS_TEAM_DOMAIN=<team>.cloudflareaccess.com
CF_ACCESS_AUD=

# Who may call the server: comma-separated emails (OAuth / browser login)
# and service token client ids (JWT common_name).
ANNOTATOR_ALLOWED_EMAILS=
ANNOTATOR_ALLOWED_SERVICE_TOKENS=

# The agent hub, for Send. The client id and secret are an Access service token created on the
# hub's Access app (the hub's own hostname), not on this one; both are sent as headers on every hub
# request and Cloudflare's edge does the exchange. The hub's principal table is what decides this
# token may send as the owner and speak for no machine.
HUB_URL=https://relay.example.com
HUB_ACCESS_CLIENT_ID=
HUB_ACCESS_CLIENT_SECRET=

# Used only by the edge e2e suite (just e2e), not by the containers.
ANNOTATOR_URL=https://annotator.example.com
E2E_CF_ACCESS_CLIENT_ID=
E2E_CF_ACCESS_CLIENT_SECRET=
