#!/usr/bin/env bash
# Refuses a commit that breaks any of the four rules the fitness gate enforces on the live
# TypeScript trees: a file past 500 lines, a relative import, a directory holding more than twelve
# source files, or a file oxfmt would rewrite.
#
# The same rules as checks 5, 6, 7 and 9 in `tools/agent-feed-fitness.sh`, moved to the moment they
# are cheap to obey. The gate is the authority and this is not a second opinion: same three trees
# (and the wire, for formatting, as check 9 reads it), same two extensions, same limits, same
# counting. If they ever disagree, the gate is right and this is the bug.
#
# Why both. The gate answers "is the tree under the cap", which is the question that matters and
# the wrong moment to ask it: by the time `just check` says no, the file is written and splitting
# it is a second job. This asks at the moment the author still has the concepts in their head,
# which is the only moment the split is nearly free.
#
# It reads the INDEX, not the worktree. A pathspec commit -- `git commit -- <paths>`, which is how
# this repository commits, because several sessions share one worktree -- builds a temporary index
# holding exactly what will land, and the hook runs against that. Reading the files on disk would
# measure a peer's half-written edit instead.
#
# Only `.ts` and `.tsx`, only under the three `src` trees that are the current path. Everything else
# in this repository is Swift, Rust, generated, vendored, or dormant, and a line cap on any of them
# would be a rule nobody agreed to.
set -uo pipefail

LIMIT=500
# Group's package is a live tree too (ADR-0155).
TREES="packages/AgentPanel/Web/src agent-feed/sidecar/src agent-feed/group/src"

staged="$(git diff --cached --name-only --diff-filter=ACMR -- $TREES | grep -E '\.tsx?$' || true)"
# Formatting covers the wire as well, the trees `tools/format.sh` formats.
FORMAT_TREES="$TREES agent-feed/wire"
format_staged="$(git diff --cached --name-only --diff-filter=ACMR -- $FORMAT_TREES | grep -E '\.tsx?$' || true)"
[ -n "$staged$format_staged" ] || exit 0

# The three specifier forms this codebase writes, anchored or parenthesised so one quoted INSIDE a
# string stays legal. Same expression as check 6 of the fitness gate, which is the authority.
RELATIVE='^[[:space:]]*(import|export)[^"'"'"']*from[[:space:]]*["'"'"']\.|^[[:space:]]*import[[:space:]]*["'"'"']\.|(import|vi\.mock|mock\.module|require)\([[:space:]]*["'"'"']\.'

oversize=""
relative=""
while IFS= read -r path; do
    [ -n "$path" ] || continue
    # The staged blob, which is what the commit will contain. `wc -l` counts newlines, exactly as
    # the fitness gate does, so a file that passes here passes there.
    lines="$(git show ":$path" 2>/dev/null | wc -l | tr -d ' ')"
    [ -n "$lines" ] || continue
    if [ "$lines" -gt "$LIMIT" ]; then
        oversize="$oversize  $lines $path"$'\n'
    fi
    hits="$(git show ":$path" 2>/dev/null | grep -nE "$RELATIVE" || true)"
    if [ -n "$hits" ]; then
        relative="$relative$(printf '%s\n' "$hits" | sed "s|^|  $path:|")"$'\n'
    fi
done <<< "$staged"

# Check 7's rule: no directory in these trees holds more than twelve source files. Only the
# directories this commit actually touches, because that is the only place it can make things
# worse, and asking about the whole tree on every commit would refuse a commit for somebody else's
# directory.
#
# Counted out of the INDEX for the same reason the line cap is: a pathspec commit builds a
# temporary index holding exactly what will land, so this counts the directory as the commit will
# leave it rather than as the worktree happens to look. A test rides with its source and is not
# counted.
#
# The three-file floor is deliberately absent. It governs the moment you are splitting -- a group
# of one or two is not a cluster -- and says nothing about a directory that is simply small, so
# there is nothing here for a hook to refuse. It is also asked of the cluster you are PROMOTING out
# of a full directory, never of the file whose arrival pushed it over.
DIR_LIMIT=12
oversized_dirs=""
while IFS= read -r dir; do
    [ -n "$dir" ] || continue
    count="$(
        git ls-files --cached -- "$dir" | awk -v prefix="$dir/" '
            index($0, prefix) == 1 {
                rest = substr($0, length(prefix) + 1)
                if (rest !~ /\// && rest ~ /\.tsx?$/ && rest !~ /\.test\.tsx?$/) n++
            }
            END { print n + 0 }
        '
    )"
    if [ "$count" -gt "$DIR_LIMIT" ]; then
        oversized_dirs="$oversized_dirs  $count $dir"$'\n'
    fi
done <<< "$(printf '%s\n' "$staged" | sed 's|/[^/]*$||' | sort -u)"

# Check 9's rule: each staged file is as oxfmt writes it. Asked of the staged blob through oxfmt's
# stdin, for the reason the line cap reads the index: the worktree may hold a peer's edit, or a
# hunk this commit leaves out.
#
# Here because the gate asks it of the whole tree, which is the wrong moment and the wrong scope:
# an unformatted file committed by one session turned every other session's `just check` red until
# its author came back, twice on 2026-10-19. Checked rather than fixed: a hook that rewrote files
# would rewrite the worktree under whoever else is editing them.
#
# oxfmt is the panel's dev dependency. A linked worktree may have no `node_modules`, so the main
# checkout's copy serves it, read with this checkout's config.
TOP="$(git rev-parse --show-toplevel)"
MAIN="$(cd "$(git rev-parse --git-common-dir)/.." && pwd)"
OXFMT=""
for root in "$TOP" "$MAIN"; do
    if [ -x "$root/packages/AgentPanel/Web/node_modules/.bin/oxfmt" ]; then
        OXFMT="$root/packages/AgentPanel/Web/node_modules/.bin/oxfmt"
        break
    fi
done
unformatted=""
unparsed=""
if [ -n "$format_staged" ] && [ -n "$OXFMT" ]; then
    while IFS= read -r path; do
        [ -n "$path" ] || continue
        # The trailing dot keeps a difference in trailing newlines, which `$(...)` would strip.
        if formatted="$(git show ":$path" | "$OXFMT" -c "$TOP/.oxfmtrc.json" --stdin-filepath="$path" 2>/dev/null && printf .)"; then
            [ "$formatted" = "$(git show ":$path" && printf .)" ] || unformatted="$unformatted  $path"$'\n'
        else
            unparsed="$unparsed  $path"$'\n'
        fi
    done <<< "$format_staged"
fi

status=0

if [ -n "$format_staged" ] && [ -z "$OXFMT" ]; then
    echo "pre-commit: oxfmt is not installed, so formatting cannot be checked." >&2
    echo "pre-commit: run tools/format.sh --check once, which installs the panel's dependencies." >&2
    status=1
fi

if [ -n "$unformatted" ]; then
    echo "pre-commit: these staged files are not as oxfmt writes them:" >&2
    printf '%s' "$unformatted" >&2
    echo "pre-commit: run tools/format.sh with these paths, then stage them again. Name the files:" >&2
    echo "pre-commit: with no paths it rewrites every file, a peer's half-finished edit included." >&2
    status=1
fi

if [ -n "$unparsed" ]; then
    echo "pre-commit: oxfmt could not parse these staged files; fix the syntax first:" >&2
    printf '%s' "$unparsed" >&2
    status=1
fi

if [ -n "$oversize" ]; then
    echo "pre-commit: these staged files are past the ${LIMIT}-line cap:" >&2
    printf '%s' "$oversize" >&2
    echo "pre-commit: split them by concept before committing. A file this long has stopped being" >&2
    echo "pre-commit: one idea, and the reader who needs one of its ideas pays for all of them." >&2
    status=1
fi

if [ -n "$relative" ]; then
    echo "pre-commit: these staged lines import relatively; write @/ or @repo/ instead:" >&2
    printf '%s' "$relative" >&2
    echo "pre-commit: a relative import breaks when either end moves, so it makes moving one file" >&2
    echo "pre-commit: cost every importer too. An aliased one names only what moved." >&2
    status=1
fi

if [ -n "$oversized_dirs" ]; then
    echo "pre-commit: this commit leaves these directories past the ${DIR_LIMIT}-file cap:" >&2
    printf '%s' "$oversized_dirs" >&2
    echo "pre-commit: cluster the files ALREADY THERE that are about the same thing into sibling" >&2
    echo "pre-commit: directories, then put the new file flat. A flat list of fifty hides exactly" >&2
    echo "pre-commit: what a two-thousand-line file hid, which is where one thing ends and the next" >&2
    echo "pre-commit: begins. Fewer than three is not a cluster -- asked of the group you are" >&2
    echo "pre-commit: MOVING, never of the file that arrived. Appending it to an existing file to" >&2
    echo "pre-commit: dodge the count keeps both caps green and buries the new idea." >&2
    status=1
fi

exit "$status"
