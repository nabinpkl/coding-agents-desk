<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Re-applies the tailnet-only pf anchor at boot. Anchor contents do not
       persist across restarts; this job reloads them. Runs as root. -->
  <key>Label</key><string>com.example.agentdesk.agentdesk-pf</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>/Users/dev/projects/agent-desk/tools/pf-tailnet-only.sh</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/tmp/agentdesk-pf.log</string>
  <key>StandardErrorPath</key><string>/tmp/agentdesk-pf.log</string>
</dict>
</plist>
