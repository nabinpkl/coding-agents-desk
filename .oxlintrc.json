{
  "$schema": "./packages/AgentPanel/Web/node_modules/oxlint/configuration_schema.json",
  // The lint gate for the two live TypeScript trees, run as check 8 of tools/agent-feed-fitness.sh.
  // Every rule here is an error and the tree holds none of them, so a finding is always new.
  // Only rules that were already at zero, or were cleared in the change that gated them: a rule
  // that warns on a backlog teaches everyone to ignore the output.
  "plugins": ["eslint", "typescript", "react", "import"],
  // The type-aware rules below need the types, which tsgolint (the `oxlint-tsgolint` package) reads
  // from each file's nearest tsconfig.json, or from one that config's directory's parents point
  // to. The panel's tests and the shared wire are covered by configs that are not nearest to them
  // (`Web/tsconfig.node.json`, `sidecar/tsconfig.json`), so `packages/AgentPanel/tsconfig.json`
  // and `agent-feed/tsconfig.json` reference them; without those two, those files were linted
  // with default options and every `@/` import read as `any`. Check 8 tells oxlint where the
  // binary is.
  "options": { "typeAware": true },
  "categories": {
    "correctness": "off",
    "suspicious": "off",
    "pedantic": "off",
    "perf": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "rules": {
    // Splitting a file under the 500-line cap leaves imports and helpers behind in the half that
    // stopped using them; 287 unused imports had built up that way by 2026-10-17. Not
    // `noUnusedLocals` in tsconfig: the dev server and the sidecar supervisor hold a save on a new
    // type error, and an unused import mid-edit is not a reason to hold one.
    "eslint/no-unused-vars": [
      "error",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "caughtErrorsIgnorePattern": "^_" }
    ],
    "react-hooks/rules-of-hooks": "error",
    // React Compiler's own checks, run as lint. Each is something the compiler cannot keep correct
    // and so leaves the component uncompiled: a ref read or written while rendering, a value it
    // treats as frozen being changed, a clock read in render, an outside variable reassigned from
    // one, a state set synchronously in an effect. Cleared on 2026-10-18 (90 findings); the panel
    // builds with the compiler (`panelReact.ts`), so a finding here is a component it would skip.
    // Two quirks of how it decides what a ref is: a name ending in `Ref` is one, and an object
    // holding a ref makes every read off that object look like a read of the ref, so a hook's ref
    // goes apart from the rest of what it returns.
    "react/refs": "error",
    "react/immutability": "error",
    "react/purity": "error",
    "react/globals": "error",
    "react/set-state-in-effect": "error",
    // The rest of the compiler's checks, gated on 2026-10-18 while all but one were at zero: a hook
    // called conditionally, a hand-written memo the compiler cannot keep, a state set while
    // rendering, a component defined inside another, syntax it cannot compile. The one that was not
    // is `memo-dependencies`, whose four findings included one the compiler had already broken: a
    // memo listed `machines` so it would rebuild when they changed, but read nothing of them, and the
    // compiler keys a memo on what it reads, so it never rebuilt.
    "react/hooks": "error",
    "react/preserve-manual-memoization": "error",
    "react/set-state-in-render": "error",
    "react/static-components": "error",
    "react/unsupported-syntax": "error",
    "react/memo-dependencies": "error",
    // An assertion that changes nothing is an assertion nobody re-checks when the type under it
    // changes; 231 were cleared with this gate, most of them `!` on a value already narrowed.
    "typescript/no-unnecessary-type-assertion": "error",
    // A deprecated call is one the next upgrade breaks. Cleared with this gate: React 19's
    // `FormEvent`, Sentry's `forceTransaction`, bun:sqlite's `exec`.
    "typescript/no-deprecated": "error",
    // `== null` is left alone: it is how this tree says "null or undefined" in one comparison.
    "eslint/eqeqeq": ["error", "always", { "null": "ignore" }],
    // Throw and reject with errors, not strings. A caught `unknown` passed on is allowed: it is
    // whatever was thrown, and wrapping it would change what the caller catches.
    "typescript/only-throw-error": ["error", { "allowThrowingUnknown": true }],
    "typescript/prefer-promise-reject-errors": ["error", { "allowThrowingUnknown": true }],
    // A cycle is how a plain helper exported from a component file shows up: the eight cleared
    // with this gate were all `harnessName` living in SessionView.tsx.
    "import/no-cycle": "error",
    // A rethrow without `cause` loses the error that explains it.
    "eslint/preserve-caught-error": "error",
    // A promise nobody awaits or catches is a failure nobody hears about: the desktop helper's
    // stdin writes went unawaited, so a helper dying under a full pipe went unreported. `act` is
    // exempt because React 19 types it as a promise even when the callback is synchronous; an
    // intentional fire-and-forget says so with `void`.
    "typescript/no-floating-promises": [
      "error",
      {
        "allowForKnownSafeCalls": [
          { "from": "package", "name": "act", "package": "react" },
          { "from": "package", "name": "act", "package": "@testing-library/react" }
        ]
      }
    ],
    // A promise handed to something that expects a plain callback. JSX handler props and object
    // properties are left out: every async `onSubmit` and `onClick` here catches its own failure,
    // and the rule cannot tell those from the ones that do not.
    "typescript/no-misused-promises": [
      "error",
      { "checksVoidReturn": { "attributes": false, "properties": false } }
    ],
    // No effects outside the approved hooks (ADR-0146). The panel had 310 on 2026-10-18, most of
    // them copied from the file next door: state derived a render late, a fetch with its own
    // cancel flag, a write to storage watching a value. Each of those has a better home -- the
    // render, a query (`@/query/panelQuery`), a store, the event handler -- and an effect left
    // anywhere is the example the next one gets copied from.
    "eslint/no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "react",
            "importNames": ["useEffect", "useLayoutEffect", "useInsertionEffect"],
            "message": "Compute it in render, read it with usePanelQuery, subscribe through a store, do it in the event handler, or use a hook from @/hooks (ADR-0146)."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      // A test's stand-in for a browser object has to define every member of the interface it
      // stands in for, deprecated ones included: jsdom's missing `matchMedia` is faked as a whole
      // `MediaQueryList`, `addListener` and all. A deprecated call a test makes fails that test
      // when the upgrade removes it, which is the check this rule is for.
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/AgentPanel/Web/src/**/*Harness.tsx",
        "**/AgentPanel/Web/src/app/testSetup.ts"
      ],
      "rules": { "typescript/no-deprecated": "off" }
    },
    {
      // The approved hooks, each named for the outside thing it keeps in step with React, and the
      // tests, whose harnesses stand up whatever the component under test expects to find.
      "files": ["**/AgentPanel/Web/src/hooks/**", "**/AgentPanel/Web/src/**/*.test.ts", "**/AgentPanel/Web/src/**/*.test.tsx"],
      "rules": { "eslint/no-restricted-imports": "off" }
    },
    {
      // Hooks named for one outside system, beside the feature that uses it: each starts and
      // stops objects that keep working until they are cancelled or destroyed.
      "files": [
        // pdf.js documents, render tasks and text layers.
        "**/AgentPanel/Web/src/features/workspace-ide/editor/usePdfJs.ts",
        // A tmux pane's composer box: the debounced push of the draft into the pane, which a
        // submit cancels by hand.
        "**/AgentPanel/Web/src/features/cli-input/useTmuxComposer.ts",
        // A Mac window's composer field, through the host's accessibility watch: the focus-gated
        // watch, and the debounced push of the draft into it, which a send cancels by hand.
        "**/AgentPanel/Web/src/features/session-view/composer/useWindowComposer.ts",
        // The transcript's virtualiser: what it has laid out and where it is scrolled to. Pages are
        // asked for as gaps and the top come into its visible range, and a remembered position is
        // restored once its row has been measured, all of which is known only after layout.
        "**/AgentPanel/Web/src/features/activity-feed/scroll-position/useTranscriptScrollRestore.ts",
        "**/AgentPanel/Web/src/features/activity-feed/scroll-position/useGapFill.ts",
        "**/AgentPanel/Web/src/features/activity-feed/scroll-position/useOlderPageAnchor.ts",
        // The canvas scroller's remembered position: put back once the strip is wide enough to take
        // it, re-asked every frame until it is or the reader takes over, and written down on leaving.
        "**/AgentPanel/Web/src/features/bots/canvas/useRememberedCanvasScroll.ts",
        // The same restore on the terminal canvas's strip, and its put-back when a phone keyboard
        // closes.
        "**/AgentPanel/Web/src/features/terminal/canvas/useTerminalCanvasScroll.ts",
        // xterm: a terminal opened on a mount, attached to a pane or PTY, fed its stream, resized
        // with its box and disposed with it.
        "**/AgentPanel/Web/src/features/terminal/useAgentTerminal.ts",
        // A WebRTC session with the far Mac's display: peers offered, retired and reconnected, and
        // closed on page hide so the sidecar does not keep a capture for a viewer that left.
        "**/AgentPanel/Web/src/features/desktop-viewer/tile-stream/TileStreamRtc.tsx",
        // The far Mac's pointer: a held finger becomes a held mouse button there, so every gesture
        // surface is bound to its elements and releases what it holds when it goes.
        "**/AgentPanel/Web/src/features/desktop-viewer/tile-viewport/TileViewport.tsx",
        "**/AgentPanel/Web/src/features/desktop-viewer/trackpad/useTrackpadGestures.ts",
        "**/AgentPanel/Web/src/features/desktop-viewer/trackpad/useScrollStripGestures.ts"
      ],
      "rules": { "eslint/no-restricted-imports": "off" }
    }
  ]
}
