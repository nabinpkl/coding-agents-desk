# Dev-mode toggles. Set these via launchctl setenv before `open`ing the
# host bundle, or via Justfile's host-run recipe.

AGENTDESK_DEV_PERMISSIVE_KEYSTORE=1     # skip the SE/keychain ACL prompts
AGENTDESK_AUTO_APPROVE=1                # auto-approve pairing for dev

# Owned media. Pairing, session auth, input, and Tailscale stay separate.
# Video is one VideoToolbox surface over authenticated QUIC datagrams.
AGENTDESK_OWNED_MEDIA_CODEC=hevc|h264    # default hevc
AGENTDESK_OWNED_MEDIA_CHROMA=420|444|bgra               # default 420; 444 is a strict ceiling probe
AGENTDESK_OWNED_MEDIA_HEVC_PROFILE=main|main10|main42210|main444|main44410
AGENTDESK_OWNED_MEDIA_MAX_QP=24                         # optional VideoToolbox quality ceiling
AGENTDESK_OWNED_MEDIA_DATAGRAM_BURST_PACKET_COUNT=32    # datagram pacing, packets before a pause
AGENTDESK_OWNED_MEDIA_DATAGRAM_BURST_PAUSE_US=1000      # datagram pacing, 0 disables pacing
AGENTDESK_OWNED_MEDIA_QUIC_MAX_DATAGRAM_BYTES=1200      # QUIC max datagram frame size
AGENTDESK_OWNED_MEDIA_CAPTURE_SCALE_DOWN=1.0            # owned capture scale; >1 lowers packet pressure
AGENTDESK_OWNED_MEDIA_BITRATE_KBPS=8000                 # owned VideoToolbox bitrate target
AGENTDESK_OWNED_MEDIA_FPS=30                            # owned VideoToolbox expected frame rate
AGENTDESK_OWNED_MEDIA_KEYFRAME_INTERVAL_FRAMES=120      # larger values reduce full-frame packet bursts
AGENTDESK_OWNED_MEDIA_REPAIR_DEADLINE_MS=50             # wait this long for packet repair before keyframe fallback
AGENTDESK_OWNED_MEDIA_RESEND_RING_FRAMES=8              # host keeps exact datagrams for this many recent frames
AGENTDESK_OWNED_MEDIA_MAX_RESEND_PACKETS=256            # cap one packet-resend-request response

# Host dictation bar. Transcription runs against an OpenAI-compatible
# /v1/audio/transcriptions endpoint; the clip is held in memory and POSTed
# as multipart (fields file + model). The URL is REQUIRED and has no
# baked-in default: unset it and dictation fails loudly instead of POSTing
# at a host that may not be running. If AGENTDESK_VOICE_CHILD_PATH is set,
# dictation uses the owned stdio child instead and this URL is only fallback.
AGENTDESK_TRANSCRIBE_URL=http://localhost:8001/v1/audio/transcriptions
AGENTDESK_TRANSCRIBE_MODEL=mlx-community/whisper-large-v3-turbo          # default

# Voice-agent child bridge. Preferred dictation path. Point this at uv and
# run the packaged voice child from the gesture-agent checkout.
AGENTDESK_VOICE_CHILD_PATH=/Users/dev/.local/bin/uv
AGENTDESK_VOICE_CHILD_ARGS=--project /Users/dev/projects/gesture-agent run voice-agent-child

# Terminal-launcher pill. It toggles Ghostty's quick terminal by activating the
# app and synthesizing Cmd-` (the chord the Ghostty config binds, non-global so
# Ghostty needs no Accessibility; the host already has it). Override the app and
# its bundle id together to drive a different terminal.
AGENTDESK_TERMINAL_APP=/Applications/Ghostty.app            # default
AGENTDESK_TERMINAL_BUNDLE_ID=com.mitchellh.ghostty          # default

# Space Agent panel orientation. vertical (default) stacks desktops in a column
# to the left of the rocket; horizontal keeps the original strip below it.
AGENTDESK_SPACE_AGENT_LAYOUT=horizontal|vertical            # default vertical

# Gesture-agent child bridge. Disabled when path is unset. Point this at uv and
# run the packaged gesture child from the gesture-agent checkout.
AGENTDESK_GESTURE_CHILD_PATH=/Users/dev/.local/bin/uv
AGENTDESK_GESTURE_CHILD_ARGS=--project /Users/dev/projects/gesture-agent run gesture-agent-child
