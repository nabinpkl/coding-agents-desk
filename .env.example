# Identity and signing. One prefix names every bundle id: the host, the client, and their .dev
# variants. Leave both unset to build and run on this Mac with ad-hoc signing and placeholder ids;
# the cost is that macOS asks again for Screen Recording, Accessibility and keychain access after
# each rebuild, because it ties them to the signature. A team gives the builds a stable identity,
# and an iPhone install needs one. A team needs a prefix of your own: App IDs are unique across
# every team, so the placeholder is refused.
# AGENTDESK_BUNDLE_PREFIX=com.yourname.agentdesk
# AGENTDESK_APPLE_TEAM_ID=ABCDE12345     # Apple Developer team id

# Your iPhone and simulators, for the native client's device and simulator recipes. Left unset, a
# recipe that needs one fails naming the setting.
# AGENTDESK_IOS_DEVICE=00008000-0000000000000000    # xcrun devicectl list devices
# AGENTDESK_IOS_SIM_UDID=00000000-0000-0000-0000-000000000000      # xcrun simctl list devices
# AGENTDESK_IOS_SIM_UDID_DEV=00000000-0000-0000-0000-000000000000

# deskzoom, the virtual display, read by deskzoom/justfile. Ad-hoc signed and a placeholder id by
# default; your Apple Development identity keeps its Screen Recording grant across rebuilds.
# DESKZOOM_SIGN_IDENTITY=Apple Development: Your Name (ABCDE12345)
# DESKZOOM_BUNDLE_ID=com.yourname.deskzoom

# Where the panel's dev server can be reached from. loopback (the default): this Mac only. tailnet:
# this Mac and your tailnet, over https under the tailnet name, which is what a phone needs.
# network: every network this Mac is on, over plain http, for a phone without Tailscale. The panel
# has no login and drives this Mac, so network mode only on a network you trust.
# AGENTDESK_PANEL_LISTEN=tailnet

# Dev-mode toggles. Set these via launchctl setenv before `open`ing the
# host bundle, or via Justfile's host-run recipe.

AGENTDESK_AUTO_APPROVE=1                # auto-approve pairing for dev

# TestFlight upload. The .p8 key is secret material and must stay outside git.
# `just testflight-upload` uses these with xcrun altool after exporting the IPA.
AGENTDESK_CLIENT_VERSION=1.0            # CFBundleShortVersionString for Release archives
AGENTDESK_CLIENT_BUILD=20260621173045   # optional; unset to use a UTC timestamp
AGENTDESK_ASC_KEY_ID=ABC123DEFG         # App Store Connect API key id
AGENTDESK_ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000 # App Store Connect issuer id
AGENTDESK_ASC_API_KEY_PATH=/Users/you/.appstoreconnect/private_keys/AuthKey_ABC123DEFG.p8

# Live session transport. Pairing offers stay on the plain TCP offer port. Once
# paired, session auth, input, host pushes, and media datagrams share one
# authenticated QUIC session connection (ADR-0030).
AGENTDESK_OFFER_PORT=41890                            # ADR-0019 Mac-initiated pairing offer (plain TCP over the tailnet); host and client must agree
AGENTDESK_WORKSPACE_FILE_MAX_BYTES=4194304             # bounded UTF-8 Files read/write payload
AGENTDESK_WORKSPACE_DOCUMENT_MAX_BYTES=104857600       # read-only DOCX admission ceiling; cannot exceed 100 MiB

# Owned media. HEVC remains the primary full-frame refresh path over the unified
# QUIC session's authenticated datagram lane. Retained tile knobs below feed the
# local crisp-repair/compositor path; there is no separate graphics connection.
AGENTDESK_HYBRID_SCROLL_HEVC_FPS=0                    # planned R32 default: suppress HEVC full-frame refresh during accepted scroll
AGENTDESK_HYBRID_SCROLL_IDLE_REFRESH_MS=250           # planned R32 default: force one HEVC rest refresh after scroll idle
AGENTDESK_HYBRID_RESET_STRIPE_MAX_DECODED_BYTES=2097152 # max decoded BGRA bytes per retained reset stripe
AGENTDESK_HYBRID_RESET_STRIPE_MAX_WIRE_BYTES=196608  # max encoded ADGC wire bytes per retained reset stripe
AGENTDESK_HYBRID_RESET_STRIPE_ACK_TIMEOUT_MS=1000     # max wait for each retained reset stripe ACK
AGENTDESK_HYBRID_GRAPHICS_FALLBACK_MIN_INTERVAL_MS=1500 # min interval between HEVC correctness refreshes during graphics recovery
AGENTDESK_OWNED_MEDIA_VIDEO_MOTION_ENABLED=1            # default on; HEVC datagram carrier is the primary media path (0 = reliable tiles only)
AGENTDESK_OWNED_MEDIA_MOTION_MODE=always_video          # default always_video (continuous video, no tiles); tiles_motion = video on scroll, crisp tiles at rest
AGENTDESK_OWNED_MEDIA_CODEC=hevc|h264    # default hevc
AGENTDESK_OWNED_MEDIA_CHROMA=420|444|bgra               # default 420; 444 is a strict ceiling probe
AGENTDESK_OWNED_MEDIA_HEVC_PROFILE=main|main10|main42210|main444|main44410
AGENTDESK_OWNED_MEDIA_MAX_QP=24                         # optional VideoToolbox quality ceiling
AGENTDESK_OWNED_MEDIA_DATAGRAM_BURST_PACKET_COUNT=32    # datagram pacing, packets before a pause
AGENTDESK_OWNED_MEDIA_DATAGRAM_BURST_PAUSE_US=1000      # datagram pacing, 0 disables pacing
AGENTDESK_OWNED_MEDIA_LARGE_FRAME_PACKET_THRESHOLD=64    # large delta frames get smoother pacing
AGENTDESK_OWNED_MEDIA_JUMBO_FRAME_PACKET_THRESHOLD=128   # jumbo delta frames get the smoothest non-backpressure pacing
AGENTDESK_OWNED_MEDIA_LARGE_FRAME_BURST_PACKET_COUNT=24  # packets before pause for large non-keyframes
AGENTDESK_OWNED_MEDIA_LARGE_FRAME_BURST_PAUSE_US=1500    # pause for large non-keyframes
AGENTDESK_OWNED_MEDIA_JUMBO_FRAME_BURST_PACKET_COUNT=16  # packets before pause for jumbo non-keyframes
AGENTDESK_OWNED_MEDIA_JUMBO_FRAME_BURST_PAUSE_US=1500    # pause for jumbo non-keyframes
AGENTDESK_OWNED_MEDIA_QUIC_MAX_DATAGRAM_BYTES=1200      # QUIC max datagram frame size
AGENTDESK_OWNED_MEDIA_CRISP_HEAL_INTERVAL_WINDOWS=10    # ADR-0036; crisp windows between full-surface heals (crisp observe is damage-gated between them); 0 = always full heal
AGENTDESK_OWNED_MEDIA_CAPTURE_SCALE_DOWN=1.0            # owned capture scale; >1 lowers packet pressure
AGENTDESK_OWNED_MEDIA_BITRATE_KBPS=2500                 # adaptive controller ceiling + starting target (ADR-0027; was 8000, dropped after device testing showed no text-quality cost)
AGENTDESK_OWNED_MEDIA_DATA_RATE_LIMIT_RATIO=1.5         # hard DataRateLimits ceiling = ratio x avg bitrate over a 1s window; bounds keyframe burst on constrained links (ADR-0027)
AGENTDESK_OWNED_MEDIA_BITRATE_FLOOR_KBPS=800           # adaptive controller floor under sustained loss (ADR-0027)
AGENTDESK_OWNED_MEDIA_BITRATE_DOWN_STEP=0.7            # multiply target on a lossy window (down fast)
AGENTDESK_OWNED_MEDIA_BITRATE_UP_STEP=1.15            # multiply target after a clean streak (up slow)
AGENTDESK_OWNED_MEDIA_BITRATE_LOSS_DOWN_PERMILLE=50    # window loss per-mille at/above which the controller steps down (50 = 5%)
AGENTDESK_OWNED_MEDIA_BITRATE_RAISE_CLEAN_WINDOWS=4    # consecutive clean windows before a step up
AGENTDESK_OWNED_MEDIA_SURVIVAL_BITRATE_FLOOR_KBPS=300  # survival wire-rate floor after 800kbps is pinned and loss persists with fps down (ADR-0029)
AGENTDESK_OWNED_MEDIA_FPS=30                            # owned VideoToolbox expected frame rate (cadence ceiling)
AGENTDESK_OWNED_MEDIA_FPS_FLOOR=10                      # survival cadence floor: controller drops produce/encode fps toward this once 800kbps is pinned and still losing (ADR-0029)
AGENTDESK_OWNED_MEDIA_FPS_DOWN_STEP=0.7                 # multiply target fps on a lossy window while bitrate is at floor (down)
AGENTDESK_OWNED_MEDIA_FPS_UP_STEP=1.3                  # multiply target fps after a clean streak once bitrate is back at ceiling (up)
AGENTDESK_OWNED_MEDIA_MOTION_BUDGET_ENABLED=1           # enables temporary motion encode budget from ACK/backlog pressure
AGENTDESK_OWNED_MEDIA_MOTION_BITRATE_KBPS=5000          # motion VideoToolbox bitrate target while client is behind
AGENTDESK_OWNED_MEDIA_MOTION_FPS=15                     # motion VideoToolbox expected frame rate while client is behind
AGENTDESK_OWNED_MEDIA_MOTION_SCALE_DOWN=1.25            # pre-encode downscale while motion budget is active; 1.0 disables
AGENTDESK_OWNED_MEDIA_MOTION_FRAME_AGE_MS=80            # frame age threshold that enters motion budget
AGENTDESK_OWNED_MEDIA_MOTION_BACKLOG_FRAMES=1           # client backlog threshold that enters motion budget
AGENTDESK_OWNED_MEDIA_MOTION_INFLIGHT_BYTES=120000      # unacked byte threshold that enters motion budget
AGENTDESK_OWNED_MEDIA_REST_BUDGET_HOLD_MS=500           # hold motion budget briefly after pressure clears
AGENTDESK_OWNED_MEDIA_KEYFRAME_INTERVAL_FRAMES=120      # larger values reduce full-frame packet bursts
AGENTDESK_OWNED_MEDIA_REPAIR_DEADLINE_MS=50             # wait this long for packet repair before keyframe fallback
AGENTDESK_OWNED_MEDIA_RESEND_RING_FRAMES=240            # host keeps exact datagrams for this many recent frames (served on a packet-resend-request, ADR-0028)
AGENTDESK_OWNED_MEDIA_MAX_RESEND_PACKETS=256            # cap one packet-resend-request response
AGENTDESK_OWNED_MEDIA_KEYFRAME_REQUEST_MIN_GAP_MS=300   # client: min gap between expiry-path keyframe requests so a loss burst cannot storm keyframes before a resend lands (ADR-0028)
AGENTDESK_OWNED_MEDIA_KEEPALIVE_INTERVAL_MS=5000        # client control keepalive so sparse HEVC does not idle media QUIC out
AGENTDESK_OWNED_MEDIA_RENDER_STALL_MS=1000              # client render-stall watchdog: frames arriving but none presenting for this long flushes + asks for a keyframe (ADR-0027)
AGENTDESK_OWNED_MEDIA_LINK_HEALTH_INTERVAL_MS=500       # client link-health report cadence feeding the host adaptive bitrate controller (ADR-0027)
AGENTDESK_OWNED_MEDIA_BACKPRESSURE_FRAME_AGE_MS=80      # capture-to-render age that slows host encode admission
AGENTDESK_OWNED_MEDIA_BACKPRESSURE_SEVERE_FRAME_AGE_MS=500 # capture-to-render age that enters admission drain
AGENTDESK_OWNED_MEDIA_BACKPRESSURE_MAX_INFLIGHT_FRAMES=2 # unacked sent frames allowed before stricter pacing
AGENTDESK_OWNED_MEDIA_BACKPRESSURE_MAX_INFLIGHT_BYTES=300000 # unacked sent bytes allowed before stricter pacing
AGENTDESK_OWNED_MEDIA_BACKPRESSURE_BURST_PACKET_COUNT=16 # stricter datagram burst size while client is behind
AGENTDESK_OWNED_MEDIA_BACKPRESSURE_BURST_PAUSE_US=2500  # stricter datagram pause while client is behind
AGENTDESK_OWNED_MEDIA_BACKPRESSURE_ENCODE_INTERVAL_MS=67 # host encode cadence while client is behind
AGENTDESK_OWNED_MEDIA_BACKPRESSURE_SEVERE_ENCODE_INTERVAL_MS=200 # host encode cadence while severely behind
AGENTDESK_OWNED_MEDIA_DRAIN_TIMEOUT_MS=700              # severe drain window before latest-frame admission reopens
AGENTDESK_OWNED_MEDIA_KEYFRAME_COOLDOWN_MS=1000         # minimum gap between owned media keyframes
AGENTDESK_OWNED_MEDIA_NORMAL_MAX_UNACKED_FRAMES=2       # RDP-style normal frame lifecycle budget
AGENTDESK_OWNED_MEDIA_BEHIND_MAX_UNACKED_FRAMES=1       # RDP-style behind frame lifecycle budget
AGENTDESK_OWNED_MEDIA_STALE_UNACKED_MS=350              # abandon stale unacked frames for admission accounting without forcing keyframe recovery

# Terminal-launcher pill. It toggles Ghostty's quick terminal by activating the
# app and synthesizing Cmd-` (the chord the Ghostty config binds, non-global so
# Ghostty needs no Accessibility; the host already has it). Override the app and
# its bundle id together to drive a different terminal.
AGENTDESK_AGENT_TERMINAL_HANDOFF_TIMEOUT_SECONDS=10    # seconds to retain the bootstrap PTY attachment awaiting native handoff
AGENTDESK_AGENT_TERMINAL_TOMBSTONE_LIMIT=256           # bounded stale request IDs retained per terminal endpoint and coordinator
AGENTDESK_PTY_LEASED_SESSION_GRACE_SECONDS=30          # final-client lease grace before the manager asks the vault to reap a leased PTY
AGENTDESK_PTY_RUNTIME_PEER_TIMEOUT_SECONDS=5           # host wait for a launched PTY runtime generation to own its inherited socket
AGENTDESK_PTY_RUNTIME_IDENTITY_TIMEOUT_SECONDS=2       # host wait for the active PTY runtime generation to publish pid and digest
AGENTDESK_PTY_HANDOVER_TIMEOUT_MILLISECONDS=5000       # local manager/vault handover read, write, and candidate-accept deadline
AGENTDESK_PTY_HANDOVER_MAX_PENDING_INPUT_FRAMES=16     # in-flight plus queued input frames retained across manager handover
AGENTDESK_PTY_HANDOVER_MAX_PENDING_INPUT_BYTES=1048576 # total retained input bytes accepted by a manager handover candidate
AGENTDESK_TERMINAL_APP=/Applications/Ghostty.app            # default
AGENTDESK_TERMINAL_BUNDLE_ID=com.mitchellh.ghostty          # default

# Space Agent panel orientation. vertical (default) stacks desktops in a column
# to the left of the rocket; horizontal keeps the original strip below it.
AGENTDESK_SPACE_AGENT_LAYOUT=horizontal|vertical            # default vertical

# Voice sidecar (host-owned, loopback-only). Env-driven dev launch: point at uv
# and the in-repo gesture-agent tree to run `voice-server` without the bundled
# venv. Unset in a shipped build, where the first-launch provisioner builds it.
AGENTDESK_VOICE_UV_PATH=/Users/you/.local/bin/uv
AGENTDESK_VOICE_PROJECT_DIR=/Users/you/projects/agent-desk/gesture-agent
AGENTDESK_SPACE_THUMBNAILS_ENABLED=1                    # ADR-0006 desktop-strip previews; 0 disables the 3s thumbnail capture/composite pipeline (reclaims host CPU, drops previews)

# Agent-feed turn summarizer: the Agent Panel's on-demand "Summarize" button.
# Provider and model are ids in Pi's own model catalog (`opencode-go` is built in and
# carries its base URL, thinking format, 1M context window and cost table). Key lives in
# Infisical as OPENCODE_GO_API_KEY. Unset AGENT_FEED_SUMMARY_API_KEY and the feature
# reports itself unconfigured rather than rendering a dead button.
AGENT_FEED_SUMMARY_PROVIDER=opencode-go
AGENT_FEED_SUMMARY_MODEL=deepseek-v4-flash          # 16 ids in Pi's opencode-go catalog
AGENT_FEED_SUMMARY_API_KEY=sk-...                   # never commit; read from Infisical
